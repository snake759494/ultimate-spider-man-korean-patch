    {
      "start": 58.74,
      "end": 59.26,
      "jp": "おい",
      "logprob": -0.22467518014972712,
      "no_speech": 0.009406614117324352,
      "ko": "이봐요!"
    },
    {
      "start": 59.62,
      "end": 61.3,
      "jp": "とんでもない干渉だな",
      "logprob": -0.22467518014972712,
      "no_speech": 0.009406614117324352,
      "ko": "간섭이 너무 심하잖아요."
    },
    {
      "start": 61.3,
      "end": 64.08,
      "jp": "ラトベリアの剣からは手を引いてもらいたい",
      "logprob": -0.22467518014972712,
      "no_speech": 0.009406614117324352,
      "ko": "라트베리아 건에서는 손 떼 줬으면 한다."
    },
    {
      "start": 64.08,
      "end": 64.76,
      "jp": "どうして",
      "logprob": -0.22467518014972712,
      "no_speech": 0.009406614117324352,
      "ko": "왜요?"
