      "jp": "違うの?",
      "logprob": -0.15850146324970785,
      "no_speech": 0.04764286428689957,
      "ko": "아니야?"
    },
    {
      "start": 10.36,
      "end": 14.82,
      "jp": "しかもスピードボールを名乗る変な奴が最高にカッコいいって",
      "logprob": -0.15850146324970785,
      "no_speech": 0.04764286428689957,
      "ko": "게다가 스피드볼이라는 이상한 녀석이\n최고로 멋지다는데."
    },
    {
      "start": 14.82,
      "end": 16.28,
      "jp": "うなされるわね",
      "logprob": -0.15850146324970785,
      "no_speech": 0.04764286428689957,
      "ko": "악몽이라도 꾸겠네."
    },
    {
      "start": 16.28,
      "end": 17.94,
      "jp": "うん、そうみたいだ",
      "logprob": -0.15850146324970785,
      "no_speech": 0.04764286428689957,
      "ko": "응, 그러게 말이야."
    },
    {
      "start": 17.94,
      "end": 19.14,
      "jp": "そのまま読んで",
      "logprob": -0.15850146324970785,
      "no_speech": 0.04764286428689957,
      "ko": "계속 읽어 봐."
    },
    {
      "start": 19.76,
      "end": 21.96,
      "jp": "RPBとかいう奴によると",
      "logprob": -0.15850146324970785,
      "no_speech": 0.04764286428689957,
      "ko": "RPB라는 사람 말로는..."
    },
    {
      "start": 22.34,
      "end": 23.24,
      "jp": "それそれよ",
      "logprob": -0.15850146324970785,
      "no_speech": 0.04764286428689957,
      "ko": "그래, 바로 그거야."
    },
    {
      "start": 23.24,
      "end": 27.3,
      "jp": "ラトベリアでは気密理に先日生物軍団を開発したとか",
      "logprob": -0.15850146324970785,
      "no_speech": 0.04764286428689957,
      "ko": "라트베리아가 극비리에 생물 군단을 개발했대."
    },
    {
      "start": 27.3,
      "end": 27.94,
      "jp": "うん",
      "logprob": -0.15850146324970785,
      "no_speech": 0.04764286428689957,
      "ko": "응."
    },
    {
      "start": 27.94,
      "end": 31.04,
      "jp": "昨日暴れてたあいつと関係ありそうだな",
      "logprob": -0.22467518014972712,
      "no_speech": 0.009406614117324352,
      "ko": "어제 난동 부린 녀석과 관련이 있겠는데."
    },
    {
      "start": 31.04,
      "end": 32.9,
      "jp": "まあそういうわけよ",
      "logprob": -0.22467518014972712,
      "no_speech": 0.009406614117324352,
      "ko": "그렇다니까."
    },
    {
      "start": 32.9,
      "end": 37.82,
      "jp": "ラトベリアの差し金で研究所を襲って物を盗んでるなら",
      "logprob": -0.22467518014972712,
      "no_speech": 0.009406614117324352,
      "ko": "라트베리아의 지시로 연구소를 습격해서\n물건을 훔치고 있다면..."
    },
    {
      "start": 38.8,
      "end": 41.1,
      "jp": "調べてみた方が良さそうだな",
      "logprob": -0.22467518014972712,
      "no_speech": 0.009406614117324352,
      "ko": "조사해 보는 게 좋겠어."
    },
    {
      "start": 41.1,
      "end": 43.14,
      "jp": "映画に行くのもいいかもね",
      "logprob": -0.22467518014972712,
      "no_speech": 0.009406614117324352,
      "ko": "영화나 보러 가도 좋을 텐데."
    },
    {
      "start": 43.14,
      "end": 45.94,
      "jp": "ちょっと待って別の電話だ",
      "logprob": -0.22467518014972712,
      "no_speech": 0.009406614117324352,
      "ko": "잠깐만, 다른 전화야."
    },
    {
      "start": 45.94,
      "end": 47.86,
      "jp": "牧場だ今すぐ",
      "logprob": -0.22467518014972712,
      "no_speech": 0.009406614117324352,
      "ko": "옥상으로 와. 지금 당장."
    },
    {
      "start": 56.82,
      "end": 58.74,
      "jp": "勝手なこと言うなよ",
      "logprob": -0.22467518014972712,
      "no_speech": 0.009406614117324352,
      "ko": "멋대로 말하지 마세요."
