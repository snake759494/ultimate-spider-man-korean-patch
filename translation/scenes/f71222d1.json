      "logprob": -0.27779875479398236,
      "no_speech": 0.06508943438529968,
      "ko": "그게 무슨 말이죠?"
    },
    {
      "start": 68.42,
      "end": 70.42,
      "jp": "手を引いてもらいたいということだ",
      "logprob": -0.27779875479398236,
      "no_speech": 0.06508943438529968,
      "ko": "손 떼 달라는 뜻이다."
    },
    {
      "start": 70.42,
      "end": 73.72,
      "jp": "わかったわかったから僕の人生に構うのはやめてくれ",
      "logprob": -0.27779875479398236,
      "no_speech": 0.06508943438529968,
      "ko": "알았어요. 알았으니까 제 인생에 참견하지 마세요."
