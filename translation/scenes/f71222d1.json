    },
    {
      "start": 6.54,
      "end": 8.96,
      "jp": "僕がミュータントの化け物ってことにされてる",
      "logprob": -0.15850146324970785,
      "no_speech": 0.04764286428689957,
      "ko": "날 돌연변이 괴물이라고 써 놨는데."
